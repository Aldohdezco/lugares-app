# Local con XAMPP/phpMyAdmin:
DATABASE_URL="mysql://root:@localhost:3306/lugares_app"

# En producción (Railway, Aiven, etc) reemplaza con la connection string que te den:
# DATABASE_URL="mysql://usuario:password@host:puerto/nombre_db"

NEXTAUTH_SECRET="genera_un_string_aleatorio_largo_aqui"
NEXTAUTH_URL="http://localhost:3000"

# Fija la zona horaria del servidor a Ciudad de México (útil sobre todo cuando
# despliegues a un host que puede estar en otro país/zona horaria)
TZ="America/Mexico_City"
