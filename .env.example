# Base de datos MySQL. Local con XAMPP:
DATABASE_URL="mysql://root:@localhost:3306/lugares_app"
# En producción (TiDB Cloud), agrega ?sslaccept=strict al final

# NextAuth: URL pública de la app y una cadena aleatoria larga (openssl rand -base64 32)
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET=""

# Fotos en Cloudinary. Si se dejan vacías, las fotos se guardan en public/imagenes
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# Registro de cuentas nuevas (cerrado si no es "true")
ALLOW_REGISTRATION=""

# Integración con LifeOS cuando la app no corre en la misma computadora
LIFEOS_TOKEN=""
LIFEOS_USER_EMAIL=""

# Zona horaria del servidor (las fechas de la app ya usan hora de CDMX de forma explícita)
TZ="America/Mexico_City"
